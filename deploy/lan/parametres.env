# Paramètres non secrets de la zone LAN (valeurs de développement / recette).
# Les valeurs réelles de la Ville sont décrites dans docs/a-brancher.md.
ENVIRONNEMENT=recette
DJANGO_ALLOWED_HOSTS=api,api-portail,localhost,127.0.0.1,equipements.chatillon.local,gardiens.chatillon.local
CSRF_TRUSTED_ORIGINS=https://equipements.chatillon.local,https://gardiens.chatillon.local,https://localhost
POSTGRES_HOST=postgres
POSTGRES_DB=equipements
POSTGRES_USER=equipements
NOMBRE_PROXIES=1
MOBILE_OPTION=A
# Annuaire : en recette, conteneur OpenLDAP de test (deploy/dev/annuaire)
LDAP_URI=ldaps://annuaire:1636
LDAP_COMPTE_SERVICE_DN=cn=svc-equipements,ou=services,dc=chatillon,dc=test
LDAP_BASE_UTILISATEURS=ou=agents,dc=chatillon,dc=test
LDAP_BASE_GROUPES=ou=groupes,dc=chatillon,dc=test
LDAP_FILTRE_UTILISATEUR=(&(objectClass=inetOrgPerson)(uid={identifiant}))
LDAP_ATTRIBUT_IDENTIFIANT=uid
LDAP_MODE_GROUPES=memberof
LDAP_FICHIER_AC=/run/secrets/ldap_ac.pem
# Services internes
GOTENBERG_URL=http://gotenberg:3000
CLAMAV_HOTE=clamav
CLAMAV_PORT=3310
SMTP_HOTE=mailpit
SMTP_PORT=1025
SMTP_TLS=0
COURRIEL_EXPEDITEUR=Équipements sportifs — Ville de Châtillon <equipements@chatillon.test>
DOCUSEAL_URL=http://docuseal:3000
DOCUSEAL_URL_PUBLIQUE=https://signature.chatillon.test
PAYFIP_ACTIF=0
PAYFIP_URL=http://simulateurs:8090/payfip
PORTAIL_URL=https://equipements.chatillon.test
BACKOFFICE_URL=https://equipements.chatillon.local
